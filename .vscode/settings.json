{
  "extensions.ignoreRecommendations": true,
  "dart.enableSdkFormatter": true,
  "dart.runPubGetOnPubspecChanges": "always",
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/ios/build": true
  },
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/ios/build": true
  },
  "files.watcherExclude": {
    "**/.dart_tool/**": true,
    "**/build/**": true,
    "**/ios/build/**": true
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.rulers": [80]
  },
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "deno.enable": true
}
