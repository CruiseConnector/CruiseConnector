<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 2026-05-31 (vucko): Push-Notifications (FCM/APNs). 'development' für
	     Debug/TestFlight; Xcode setzt für App-Store-Release automatisch
	     'production', sobald die Push-Capability aktiviert ist. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- 2026-06-02 (vucko): CarPlay-Navigations-Entitlement. OHNE dieses
	     Entitlement aktiviert iOS die CPTemplateApplicationScene NICHT → die
	     App taucht im CarPlay-Home gar nicht auf (genau das Symptom). Im
	     iOS-SIMULATOR reicht der Eintrag hier (kein Provisioning-Profil-Check)
	     → App erscheint sofort im CarPlay-Fenster.
	     WICHTIG fürs ECHTE Gerät / App Store: Dort muss Apple die CarPlay-
	     Berechtigung freigeben UND das Provisioning-Profil sie enthalten
	     (Antrag läuft). Ein Debug-Build auf ein echtes iPhone würde sonst beim
	     Signieren scheitern — dann dieses Entitlement temporär entfernen. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
