<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 2026-05-31 (vucko): Push-Notifications (FCM/APNs). 'development' für
	     Debug/TestFlight; Xcode setzt für App-Store-Release automatisch
	     'production', sobald die Push-Capability aktiviert ist. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
